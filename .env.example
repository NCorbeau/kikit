# The server does not load this file automatically. Export variables in your shell.
# Production app variables (use actual secrets through Railway, never commit them).
NODE_ENV=production
KIKIT_ORIGIN=https://kikit.example.com
DATABASE_URL=postgres://kikit_runtime:REPLACE_ME@postgres.railway.internal:5432/railway
BETTER_AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
RESEND_API_KEY=REPLACE_ME
KIKIT_EMAIL_FROM=Kikit <sign-in@auth.example.com>
PORT=3001
# Supply only to the separately invoked migration command, with a privileged role.
# KIKIT_MIGRATION_DATABASE_URL=postgres://kikit_migrator:REPLACE_ME@postgres.railway.internal:5432/railway
